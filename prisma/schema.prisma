generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
  PARCEIRO
}

enum ProposalStatus {
  CONSULTA
  DIGITACAO
  ANALISE
  APROVADA
  RECUSADA
  PAGA
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  commissionPercent Decimal @default(10.00) @db.Decimal(5, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@map("users")

  clients          Client[]                @relation("PartnerClients")
  proposals        Proposal[]              @relation("PartnerProposals")
  statusChanges    ProposalStatusHistory[] @relation("StatusChangedBy")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cpf       String   @unique
  phone     String?
  email     String?
  partnerId String   @db.Uuid
  partner   User     @relation("PartnerClients", fields: [partnerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals Proposal[]

  @@index([partnerId, createdAt])
  @@map("clients")
}

model Proposal {
  id                       String         @id @default(uuid()) @db.Uuid
  clientId                 String         @db.Uuid
  client                   Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  partnerId                String         @db.Uuid
  partner                  User           @relation("PartnerProposals", fields: [partnerId], references: [id], onDelete: Restrict)
  amount                   Decimal        @db.Decimal(12, 2)
  termMonths               Int
  monthlyRate              Decimal        @db.Decimal(7, 4)
  status                   ProposalStatus @default(CONSULTA)
  commissionAmount         Decimal?       @db.Decimal(12, 2)
  commissionPercentSnapshot Decimal?       @db.Decimal(5, 2)
  paidAt                   DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  statusHistory ProposalStatusHistory[]

  @@index([status, createdAt])
  @@index([partnerId, status])
  @@map("proposals")
}

model ProposalStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  proposalId String         @db.Uuid
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fromStatus ProposalStatus?
  toStatus   ProposalStatus
  actorId    String         @db.Uuid
  actor      User           @relation("StatusChangedBy", fields: [actorId], references: [id], onDelete: Restrict)
  changedAt  DateTime       @default(now())

  @@index([proposalId, changedAt])
  @@map("proposal_status_history")
}

model PricingRule {
  id          String   @id @default(uuid()) @db.Uuid
  termMonths  Int      @unique
  monthlyRate Decimal  @db.Decimal(7, 4)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("pricing_rules")
}